msgstr "Analyse terminée. Chargement du rapport..."

#: includes/class-admin.php:64
msgid ""
"The analysis was interrupted. Click \"Resume\" to continue where it stopped."
msgstr ""
"L'analyse a été interrompue. Cliquez sur « Reprendre » pour continuer là où "
"elle s'est arrêtée."

#: includes/class-admin.php:65
msgid "Start a new analysis? The current results will be replaced."
msgstr "Lancer une nouvelle analyse ? Les résultats actuels seront remplacés."

#: includes/class-admin.php:66
msgid "The analysis is running. If you leave, you can resume it later."
msgstr ""
"L'analyse est en cours. Si vous quittez la page, vous pourrez la reprendre "
"plus tard."

